# Copy to .env and fill in. The system runs without the optional keys.

# --- Required for AI narratives (optional: falls back to templates) ---
ANTHROPIC_API_KEY=not_set

# --- Telegram delivery (required to receive picks on your phone) ---
TELEGRAM_BOT_TOKEN=not_set
TELEGRAM_CHAT_ID=not_set

# --- Optional data enrichment (system degrades gracefully without these) ---
POLYGON_API_KEY=not_set
UNUSUAL_WHALES_API_KEY=not_set
REDDIT_CLIENT_ID=not_set
REDDIT_CLIENT_SECRET=not_set

# --- Optional: override the narrative model ---
# NARRATIVE_MODEL=claude-opus-4-8
